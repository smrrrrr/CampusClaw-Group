# 复制为根目录 .env 后填写；不要提交真实 .env。
JWT_SECRET_KEY=
# 留空时 AI 使用现有降级行为；真实生成需要有效的服务端密钥。
DEEPSEEK_API_KEY=
# Docker 数据目录。使用当前开发数据副本时填写 ./data/current。
CAMPUSCLAW_DATA_DIR=./data
# Windows Docker 共享目录用 DELETE；原生 Linux 数据盘可改为 WAL。
SQLITE_JOURNAL_MODE=DELETE
# 本机已有其他部署占用 8080 时可改为 8081。
CAMPUSCLAW_PORT=8080
# 自建 MCP 工具服务的共享令牌：同时注入 mcp-tools 与后端，两边必须一致。
# 留空时 mcp-tools 拒绝所有 /mcp 请求。生成：openssl rand -hex 32
MCP_AUTH_TOKEN=
# 加密教师登记令牌用的服务端密钥（Fernet）。丢失或轮换后，已登记服务器须重新填写令牌。
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MCP_TOKEN_KEY=
# 允许服务端连接的 MCP 主机清单（host[:port]，逗号分隔），用于防 SSRF。
MCP_ALLOWED_HOSTS=mcp-tools:8090
# 是否开放 Swagger（/docs、/openapi.json）。仅本地调试临时置 true，默认关闭。
ENABLE_DOCS=false
